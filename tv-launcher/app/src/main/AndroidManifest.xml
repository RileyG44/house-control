<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Optional, explicitly granted by the keep-adb install option for home-network recovery. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- The apps' own recommendations (Watch Next, preview channels) in the TV provider. A normal permission on this TV. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Lets the launcher see every app that appears on a TV home screen. -->
    <queries>
        <intent><action android:name="android.intent.action.SEARCH" /></intent>
        <intent><action android:name="com.google.android.gms.actions.SEARCH_ACTION" /></intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.search.action.GLOBAL_SEARCH" />
        </intent>
        <!-- So `open` can tell whether an app takes a title's link before it starts it. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".LivingRoomApp"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LivingRoom"
        android:usesCleartextTraffic="true">

        <!-- A normal TV app entry and a real Android Home handler; takeover is reversible over ADB. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Reads each app's Now Playing info (title, art, position) and sends play/pause/seek. Granted over ADB. -->
        <service
            android:name=".media.MediaListenerService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Arrow keys, OK, Back and text entry from the phone, inside any app. Enabled over ADB. -->
        <service
            android:name=".input.RemoteInputService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_input_service" />
        </service>
    </application>
</manifest>
